# ==============================================================================
# DCA Vault Protocol — Environment Variables
# CSI ORIGIN 2026, PS-12
#
# SOURCE OF TRUTH: docs/Interface Contracts.md §13.1
# Copy this file to .env and fill in real values before running any script.
# NEVER commit .env to git.
# ==============================================================================

# ── Fork Configuration (Technical Architecture §6.2, §13) ──────────────────
# Base mainnet RPC — required for the initial `anvil --fork-url` call ONLY.
# After the fork is live, Anvil is fully local; no further RPC calls are made.
# Free-tier sources: Alchemy (https://alchemy.com), Infura (https://infura.io),
#   QuickNode (https://quicknode.com), or the public Base endpoint below.
# Public Base endpoint (rate-limited, use a paid key for stability):
#   https://mainnet.base.org
BASE_RPC_URL=

# Block to pin the fork at for reproducibility.
# Find a recent stable block: cast block-number --rpc-url $BASE_RPC_URL
# Recommended: pin once in Phase 1 and never change during the event.
FORK_BLOCK_NUMBER=

# ── Deployer Key (burner ONLY — never a funded key) ────────────────────────
# Generate a fresh burner key: cast wallet new
# Fund it on the fork with: cast rpc anvil_setBalance <address> 0xDE0B6B3A7640000
# This key MUST NOT hold real ETH or USDC on any live network.
DEPLOYER_PRIVATE_KEY=

# ── Protocol-Required On-Chain Addresses (Base Mainnet) ─────────────────────
# These are the real deployed contract addresses on Base that the Anvil fork
# inherits.  Do not change these unless you switch chains.
#
# Base USDC — deposit/yield asset (Technical Architecture §2 A3)
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Aave v3 Pool on Base
AAVE_POOL_ADDRESS=0xA238Dd80C259a72e81d7e4664a9801593F98d1c5

# Uniswap v4 PoolManager on Base
POOL_MANAGER_ADDRESS=0x498581ff718922c3f8e6a244956af099b2652b2b

# ── Demo-Run Variable (set by SeedPool.s.sol output, not hardcoded) ──────────
# MockERC20 counter-asset address — deployed fresh each run by Deploy.s.sol.
# Leave blank here; the deployment script writes this value to the console
# and optionally to a local addresses.json for use by other scripts.
MOCK_TOKEN_ADDRESS=

# ── Optional: Etherscan (Base Scan) ─────────────────────────────────────────
# Only needed for public testnet verification (Technical Architecture §2 O2).
# Leave blank for local fork demos.
ETHERSCAN_API_KEY=
