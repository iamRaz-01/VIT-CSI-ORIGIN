# ── Secrets (NEVER commit) ────────────────────────────────────────────────────
.env

# ── Foundry build artifacts ──────────────────────────────────────────────────
out/
cache/
broadcast/*/31337/
# Keep broadcast artifacts for testnets (public record)
# broadcast/*/84532/  ← keep if deploying to Base Sepolia

# ── Foundry dependencies (installed via forge install) ───────────────────────
# lib/ submodules are tracked via .gitmodules, not their contents
# Uncomment if you prefer to gitignore them and rely on forge install:
# lib/

# ── Node / Frontend ──────────────────────────────────────────────────────────
frontend/node_modules/
frontend/.next/
frontend/dist/

# ── OS / IDE ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/settings.json
*.swp
*.swo

# ── Anvil state dumps ────────────────────────────────────────────────────────
# Generated by: anvil --dump-state anvil-state.json
anvil-state.json

# ── Misc ──────────────────────────────────────────────────────────────────────
*.log
addresses.json
